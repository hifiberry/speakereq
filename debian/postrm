#!/bin/sh
set -e

case "$1" in
    remove|purge)
        if [ "$1" = "purge" ]; then
            echo "Removed LADSPA SpeakerEQ"
            echo "You may want to restart PipeWire: systemctl --user restart pipewire wireplumber"
        fi
        ;;

    upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        ;;

    *)
        echo "postrm called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0
